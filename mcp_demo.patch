+
+broker:
+  symbol: XAUUSD
+  timeframe: M5
+  magic_number: 20260930
+  terminal_path: 'C:\Program Files\MetaTrader 5\terminal64.exe'
+
+risk:
+  friday_close_hours_before: 3
+
+claude_demo:
+  lot: 0.1           # max 1.0 on demo (DEMO_MAX_LOT)
+  equity_floor: 0    # the 25% max risk per trade still applies
